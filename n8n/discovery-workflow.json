{
  "name": "ContentHub Discovery",
  "nodes": [
    {
      "id": "fcc4b124-8ae5-4457-81e7-2e0fa6e8a1e0",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "discovery-trigger",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "contenthub-discovery-trigger"
    },
    {
      "id": "e7d75a3a-fb1c-4560-8709-072a0c570471",
      "name": "Get interest label",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://tigawsmrndalzvuyjycc.supabase.co/rest/v1/interests",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "=eq.{{ $json.body.interest_id }}"
            },
            {
              "name": "select",
              "value": "label"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "SUPABASE_SERVICE_ROLE_KEY_BURAYA"
            },
            {
              "name": "Authorization",
              "value": "Bearer SUPABASE_SERVICE_ROLE_KEY_BURAYA"
            }
          ]
        },
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "dbac7527-233f-4e01-8a2a-7c07e2661ead",
      "name": "Extract label",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = $input.first().json;\nconst row = Array.isArray(raw) ? raw[0] : raw;\nconst webhookBody = $('Webhook').first().json.body;\nreturn [{ json: { label: row && row.label, user_id: webhookBody.user_id, interest_id: webhookBody.interest_id } }];"
      }
    },
    {
      "id": "082702da-60b9-49ad-a7a1-6e46a1c491fb",
      "name": "Ask Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "ANTHROPIC_API_KEY_BURAYA"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"model\": \"claude-haiku-4-5\",\n  \"max_tokens\": 1024,\n  \"tools\": [{ \"type\": \"web_search_20250305\", \"name\": \"web_search\" }],\n  \"messages\": [{ \"role\": \"user\", \"content\": \"\\\"\" + $json.label + \"\\\" konusunda dünya çapında tanınmış, alanında uzman kişilerin veya kurumların aktif, takip edilebilir 5 kaynağını öner (kişisel blog, YouTube kanalı veya akademik kaynak). Hacker News, Reddit gibi genel haber/link toplama sitelerini ÖNERME — doğrudan o uzmanın/kişinin kendi yayın kanalını seç. Sadece şu JSON formatında cevap ver, başka metin ekleme: [{\\\"type\\\":\\\"blog|youtube|academic\\\",\\\"name\\\":\\\"...\\\",\\\"url_or_handle\\\":\\\"...\\\",\\\"platform\\\":\\\"...\\\"}]\" }]\n} }}",
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "84123793-c8e5-4fb4-a1cf-d04fc1acb849",
      "name": "Parse candidates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const claudeResponse = $input.first().json;\nconst ctx = $('Extract label').first().json;\nconst content = claudeResponse.content || [];\nconst textBlocks = content.filter(b => b.type === 'text');\nconst lastText = textBlocks.length ? textBlocks[textBlocks.length - 1].text : '[]';\nconst cleaned = lastText.replace(/```json\\s*/g, '').replace(/```\\s*$/g, '').trim();\nlet candidates;\ntry { candidates = JSON.parse(cleaned); } catch (e) { candidates = []; }\nreturn [{ json: { user_id: ctx.user_id, interest_id: ctx.interest_id, candidates } }];"
      }
    },
    {
      "id": "2d8883e4-1d07-4e6f-8f88-ad934e106a8b",
      "name": "Post to discovery-webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://tigawsmrndalzvuyjycc.supabase.co/functions/v1/discovery-webhook",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "N8N_WEBHOOK_SECRET_BURAYA"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Get interest label",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get interest label": {
      "main": [
        [
          {
            "node": "Extract label",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract label": {
      "main": [
        [
          {
            "node": "Ask Claude",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ask Claude": {
      "main": [
        [
          {
            "node": "Parse candidates",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse candidates": {
      "main": [
        [
          {
            "node": "Post to discovery-webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}